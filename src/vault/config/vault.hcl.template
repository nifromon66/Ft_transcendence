ui = false
disable_mlock = false

api_addr = "${VAULT_API_ADDR}"
cluster_addr = "${VAULT_CLUSTER_ADDR}"
log_level = "${VAULT_LOGGING_LEVEL}"

listener "tcp" {
    address = "${VAULT_LISTEN_ADDRESS}"
    tls_disable = 0
    tls_client_ca_file = "${VAULT_TLS_CA_CERT}"
    tls_cert_file = "${VAULT_TLS_SERVER_CERT}"
    tls_key_file = "${VAULT_TLS_SERVER_KEY}"
}

storage "raft" {
    path = "${VAULT_STORAGE_DATA_DIR}"
    node_id = "${VAULT_STORAGE_NODE_ID}"
}